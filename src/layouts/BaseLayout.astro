---
/**
 * Shared page frame: head metadata, header, footer, global styles.
 * @typedef {object} Props
 * @property {string} title
 * @property {string} [description]
 * @property {import('../site.config.js').ShareImage} [ogImage] The link-preview image (N8); defaults to the site card.
 * @property {import('../lib/seo.js').PageType} [pageType] schema.org page type (N11); defaults to WebPage.
 * @property {{ name: string, path: string }[]} [breadcrumbs] Trail below Home, ending with this page.
 * @property {object[]} [jsonLd] Extra structured-data nodes for this page, e.g. a LearningResource.
 * @property {Date} [published] For pages that are articles (Spark images): og:type article and its date.
 * @property {boolean} [noindex] Keep the page out of search results (the 404 page).
 */
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, shareCards } from '../site.config.js';
import { BOOT_SCRIPT } from '../lib/boot-script.js';
import { canonicalPath, absoluteUrl, jsonLdText, siteGraph, webPageLd, breadcrumbLd } from '../lib/seo.js';

const {
  title,
  description = site.description,
  ogImage = shareCards.default,
  pageType = 'WebPage',
  breadcrumbs = [],
  jsonLd = [],
  published,
  noindex = false,
} = Astro.props;
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
// The build serves /about from about.html; the canonical URL is the link the site uses (N11).
const path = canonicalPath(Astro.url.pathname);
const canonical = absoluteUrl(path);
// Structured data (N11): the site, company and person on every page, then this page.
const graph = [
  ...siteGraph(),
  webPageLd({ path, title: fullTitle, description, type: pageType }),
  ...(breadcrumbs.length ? [breadcrumbLd(breadcrumbs)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The theme script must run before first paint; its text and CSP hash live in boot-script.js. -->
    <script is:inline set:html={BOOT_SCRIPT} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Claudia de Luna" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Spark images" href="/spark/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={published ? 'article' : 'website'} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(ogImage.src, site.url)} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Data, not code: the CSP doesn't apply to it, and jsonLdText escapes "<". -->
    {!noindex && <script type="application/ld+json" set:html={jsonLdText(graph)} />}
    <!-- TODO(M1): Cloudflare Web Analytics beacon + PostHog cookieless (R15) -->
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <!-- Full-width content above the page column, such as the Home hero band. -->
      <slot name="hero" />
      <div class="page-body">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
