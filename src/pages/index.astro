---
/** Home: intro, the course teaser, latest Spark image, external links (R11, section 12). */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SparkCard from '../components/SparkCard.astro';
import Decrypt from '../components/Decrypt.astro';
import HeroBand from '../components/HeroBand.astro';
import { externalLinks } from '../site.config.js';
import JourneyPicture from '../components/JourneyPicture.astro';
import JourneyStrip from '../components/JourneyStrip.astro';
import { getSpark, getCourse } from '../lib/content.js';

const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');
const { Content } = await render(home);
const [latest] = await getSpark();
const course = await getCourse();
const { latest: latestLesson, next } = course;
// The card's label and link follow the lesson's kind (spec section 12, "Home").
const KIND_WORDS = {
  game: { label: 'Latest game', link: 'Play' },
  article: { label: 'Latest article', link: 'Read' },
  lab: { label: 'Latest lab', link: 'Try it' },
};
const latestWords = latestLesson ? KIND_WORDS[latestLesson.kind] : null;
---

<BaseLayout title={home.data.title} description={home.data.description}>
  <HeroBand slot="hero">
    <h1 data-decrypt="hex" data-decrypt-ms="900" data-decrypt-hover>
      {home.data.title}
    </h1>
  </HeroBand>
  <div class="lede" data-decrypt-packets data-decrypt-links="hex">
    <Content />
  </div>

  <div class="home-grid">
    <section class="course card">
      <h2 data-decrypt="mac">How networking works</h2>
      <p class="hook">What happens when you upload a photo to Leapix?</p>
      <JourneyPicture />
      <JourneyStrip />
      <p>
        Networks are the plumbing behind everything you do online: hidden, and noticed only when the hot water stops.
        This course shows the pipes, one step at a time, starting from scratch.
      </p>
      {latestLesson?.page && (
        <div class="latest">
          <p class="label">{latestWords?.label}</p>
          <h3>
            <a href={latestLesson.page.href}>{latestLesson.page.title}</a>
          </h3>
          <p>{latestLesson.page.summary}</p>
          <p>
            <a href={latestLesson.page.href}>{latestWords?.link} →</a>
          </p>
        </div>
      )}
      {next && (
        <p class="next">
          Up next: {next.title}
          {next.familyLabel && ` (${next.familyLabel})`}
        </p>
      )}
      <p>
        <a href="/learn">Start the course</a>
      </p>
    </section>
    {latest && (
      <section class="card">
        <h2 data-decrypt="hex">Latest from the Spark</h2>
        <SparkCard entry={latest} eager />
        <p>
          <a href="/spark">All images →</a>
        </p>
      </section>
    )}
    <section class="card">
      <h2 data-decrypt="mac">Elsewhere</h2>
      <ul>
        {externalLinks.map((link) => (
          <li>
            <a href={link.url} target="_blank" rel="noopener" data-outbound={link.id}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <Decrypt />
</BaseLayout>

<style>
  /* Each Home section is a card, so the page reads as a set of distinct things. */
  .card {
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius);
    padding: var(--space-4);
  }
  .card > h2 {
    margin-block-start: 0;
  }
  /* One column on phones; two from 40rem, with the course card across both. */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
  }
  @media (width >= 40rem) {
    .home-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* The course teaser spans the grid; the Spark image follows below it. */
  .home-grid > .course {
    grid-column: 1 / -1;
  }
  .hook {
    font-size: var(--text-lg);
    color: var(--color-heading);
    margin-block-end: 0;
  }
  /* A card inside the course card: the page background sets it apart. */
  .latest {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3);
    max-width: 36rem;
  }
  .latest h3,
  .latest p {
    margin: 0 0 var(--space-1);
  }
  .label,
  .next {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
