---
/** About: bio from src/content/pages/about.md (R2). */
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import BackHome from '../components/BackHome.astro';
import Decrypt from '../components/Decrypt.astro';

const about = await getEntry('pages', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(about);
---

<BaseLayout title={about.data.title} description={about.data.description}>
  <h1 data-decrypt="hex" data-decrypt-ms="900" data-decrypt-hover>
    {about.data.title}
  </h1>
  <div data-decrypt-packets>
    <Content />
  </div>
  <BackHome />
  <Decrypt />
</BaseLayout>
