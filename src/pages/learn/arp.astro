---
/**
 * ARP simulator (R5, spec section 6). The page holds the empty stage, panels and
 * controls; src/games/arp/controller.js starts the engine and renderer in the browser.
 * Without JavaScript it shows the addressing table and a note.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import BackHome from '../../components/BackHome.astro';
import { TOPOLOGY, DEFAULT_TTL_MS, MIN_TTL_MS, MAX_TTL_MS } from '../../games/arp/engine.js';
import { shareCards } from '../../site.config.js';

const entry = await getEntry('learn', 'arp');
if (!entry) throw new Error('src/content/learn/arp.md is missing');

const hosts = TOPOLOGY.nodes.filter((node) => node.role !== 'attacker');
const ttlSeconds = DEFAULT_TTL_MS / 1000;
/** The mode switcher's choices; the value is also the URL hash (#learn, #garp). */
const MODES = [
  { value: 'learn', label: 'Learn' },
  { value: 'sandbox', label: 'Sandbox' },
  { value: 'garp', label: 'Gratuitous ARP' },
];
---

<BaseLayout title={entry.data.title} description={entry.data.summary} ogImage={shareCards.arp}>
  <h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>
  <TagList tags={entry.data.tags} />

  <noscript>
    <p class="notice">The simulator needs JavaScript. Here is the network it simulates:</p>
    <table>
      <tr>
        <th scope="col">Node</th>
        <th scope="col">IP</th>
        <th scope="col">MAC</th>
        <th scope="col">Switch port</th>
      </tr>
      {hosts.map((node) => (
        <tr>
          <td>{node.name}</td>
          <td>
            {node.ip}/{node.prefix}
          </td>
          <td>{node.mac}</td>
          <td>{node.port}</td>
        </tr>
      ))}
    </table>
  </noscript>

  <div class="arp" data-arp>
    <fieldset class="modes">
      <legend>Mode</legend>
      {MODES.map((mode) => (
        <label>
          <input type="radio" name="arp-mode" value={mode.value} checked={mode.value === 'sandbox'} />
          {mode.label}
        </label>
      ))}
    </fieldset>

    <section class="lesson" data-modes="learn" aria-labelledby="lesson-title" hidden>
      <p class="lesson-count" id="lesson-count"></p>
      <h2 id="lesson-title">Learn</h2>
      <p class="lesson-caption" aria-live="polite"></p>
      <div class="lesson-nav">
        <button id="lesson-back" type="button">
          Back
        </button>
        <button id="lesson-next" class="primary" type="button">
          Next
        </button>
      </div>
    </section>

    <section class="garp" data-modes="garp" aria-labelledby="garp-title" hidden>
      <h2 id="garp-title">Gratuitous ARP</h2>
      <p>
        A gratuitous ARP is a host announcing its own address: an ARP request for its own IP, sent to everyone. Nobody
        replies. Any host that already has that IP in its cache updates the entry to the sender’s MAC, and a host that
        owns the IP itself knows someone else is using it.
      </p>
      <div class="garp-row">
        <label for="garp-host">Announce from</label>
        <select id="garp-host">
          {hosts.map((node) => (
            <option value={node.name}>
              {node.name} ({node.ip})
            </option>
          ))}
        </select>
        <button id="garp-announce" class="primary" type="button">
          Announce
        </button>
      </div>
      <div class="garp-row">
        <button id="garp-failover" type="button">
          Failover: H2 fails, H3 takes over 192.0.2.12
        </button>
        <button id="garp-meanwhile" type="button">
          Meanwhile, on another host…
        </button>
      </div>
      <p class="garp-status" aria-live="polite"></p>
      <details class="garp-uses">
        <summary>Where you meet gratuitous ARP</summary>
        <ul>
          <li>A host announces itself when its interface comes up or DHCP gives it an address.</li>
          <li>
            A high-availability pair of load balancers or firewalls: when the standby takes over the shared address, it
            announces it, so traffic follows straight away instead of waiting for caches to expire. That is the Failover
            button.
          </li>
          <li>
            First-hop redundancy (VRRP, HSRP): the routers share a virtual MAC, so host caches need no change, but the
            new active router announces it so the switches move that MAC to its port.
          </li>
          <li>A virtual machine moving to another server announces itself from its new switch port.</li>
        </ul>
      </details>
      <p class="garp-note">
        <strong>Note:</strong> ARP has no authentication, so hosts believe any announcement. An ARP spoofing
        (man-in-the-middle) attack uses this same path to claim an address it doesn’t own. Switches defend with Dynamic
        ARP Inspection, which checks ARP against the DHCP snooping table; switch it on without trusting a failover
        pair’s port and it blocks the failover too.
      </p>
    </section>

    <form class="send" data-modes="sandbox garp" novalidate>
      <div class="field">
        <label for="arp-source">From</label>
        <select id="arp-source">
          {hosts.map((node) => (
            <option value={node.name}>
              {node.name} ({node.ip})
            </option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="arp-dest">To IP address</label>
        <input
          id="arp-dest"
          inputmode="decimal"
          autocomplete="off"
          value="192.0.2.12"
          aria-describedby="arp-dest-error"
        />
      </div>
      <div class="field">
        <label for="arp-app">Application</label>
        <select id="arp-app">
          <option value="ping">ping (ICMP)</option>
          <option value="web">web (HTTP)</option>
          <option value="dns">DNS (UDP)</option>
        </select>
      </div>
      <button class="primary" type="submit">
        Send
      </button>
      <p id="arp-dest-error" class="error" aria-live="polite"></p>
      <p class="quick">
        Try:
        <button type="button" data-ip="192.0.2.12">
          H2
        </button>
        <button type="button" data-ip="192.0.2.99">
          an unused address
        </button>
        <button type="button" data-ip="8.8.8.8">
          the internet (8.8.8.8)
        </button>
      </p>
    </form>

    <div class="playback" role="group" aria-label="Playback">
      <button id="arp-play" type="button">
        Pause
      </button>
      <button id="arp-step" type="button" data-modes="sandbox garp" disabled>
        Step
      </button>
      <label>
        Speed
        <select id="arp-speed">
          <option value="0.25">0.25×</option>
          <option value="0.5">0.5×</option>
          <option value="1" selected>
            1×
          </option>
          <option value="2">2×</option>
        </select>
      </label>
      <label class="ttl" data-modes="sandbox garp">
        Cache TTL
        <input id="arp-ttl" type="range" min={MIN_TTL_MS / 1000} max={MAX_TTL_MS / 1000} step="10" value={ttlSeconds} />
        <output id="arp-ttl-out" for="arp-ttl">
          {ttlSeconds} s
        </output>
      </label>
      <button id="arp-reset" type="button">
        Reset
      </button>
    </div>

    <figure class="stage">
      <svg
        class="topology"
        role="group"
        aria-label="Network diagram: three user devices and the router R1 on switch SW1"
      ></svg>
      <div class="bubbles"></div>
      <figcaption>
        <ul class="legend">
          <li>
            <span class="swatch user" aria-hidden="true"></span> User device (where applications run)
          </li>
          <li>
            <span class="swatch infra" aria-hidden="true"></span> Network infrastructure
          </li>
          <li>
            <span class="swatch you" aria-hidden="true"></span> You
          </li>
          <li>
            <span class="swatch request" aria-hidden="true"></span> ARP request
          </li>
          <li>
            <span class="swatch reply" aria-hidden="true"></span> ARP reply
          </li>
          <li>
            <span class="swatch data" aria-hidden="true"></span> IP data (ping, web, DNS)
          </li>
        </ul>
      </figcaption>
    </figure>

    <section class="packet" aria-labelledby="packet-title" tabindex="-1"></section>

    <div class="panels">
      <section aria-labelledby="caches-title">
        <h2 id="caches-title">ARP caches</h2>
        <div class="caches"></div>
      </section>
      <section aria-labelledby="mac-title">
        <h2 id="mac-title">SW1 MAC address table</h2>
        <div class="mac-table"></div>
      </section>
    </div>

    <section class="log" aria-labelledby="log-title">
      <h2 id="log-title">Event log</h2>
      <ol></ol>
      <p class="live visually-hidden" aria-live="polite"></p>
    </section>
  </div>
  <BackHome />
</BaseLayout>

<script>
  import { startSimulator } from '../../games/arp/controller.js';

  const root = document.querySelector('[data-arp]');
  if (root instanceof HTMLElement) startSimulator(root);
</script>

<style>
  .notice {
    font-weight: 600;
  }
  .arp {
    display: grid;
    /* One column that may shrink below its content, so wide tables scroll inside their own box. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    margin-block: var(--space-4);
  }
  /* Hidden until the script runs, so visitors without JavaScript see only the table. */
  :global(html:not(.js)) .arp {
    display: none;
  }

  button,
  select,
  input {
    font: inherit;
  }
  button {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
  }
  button:hover:not(:disabled) {
    border-color: var(--color-accent);
  }
  button:disabled {
    cursor: not-allowed;
    color: var(--color-text-muted);
  }
  button.primary {
    background: var(--color-link);
    border-color: var(--color-link);
    color: var(--color-bg);
    font-weight: 600;
  }
  select,
  input:not([type='range']) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    padding: var(--space-1) var(--space-2);
  }

  /* Parts that belong to other modes; beats the display rules below. */
  [data-modes][hidden] {
    display: none;
  }
  .modes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    border: 0;
  }
  .modes legend {
    font-weight: 600;
    margin-block-end: var(--space-1);
    padding: 0;
    width: 100%;
  }
  .modes label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
  }
  .modes label:has(:checked) {
    border-color: var(--color-link);
    background: var(--color-surface);
    font-weight: 600;
  }
  .modes label:has(:focus-visible) {
    outline: 2px solid var(--color-link);
    outline-offset: 2px;
  }

  .lesson,
  .garp {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
  }
  .lesson h2,
  .garp h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .lesson-count {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .lesson-caption {
    margin: 0 0 var(--space-3);
    min-height: 4.5em;
  }
  .lesson-nav,
  .garp-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .garp p,
  .garp details {
    margin: 0 0 var(--space-3);
  }
  .garp-row {
    margin-block-end: var(--space-3);
  }
  .garp-row label {
    font-weight: 600;
  }
  .garp-status:empty {
    display: none;
  }
  .garp-status {
    font-weight: 600;
  }
  .garp-uses ul {
    margin: var(--space-2) 0 0;
    padding-inline-start: 1.25em;
  }
  .garp-uses li + li {
    margin-block-start: var(--space-1);
  }
  .garp .garp-note {
    border-inline-start: 4px solid var(--color-accent);
    padding-inline-start: var(--space-3);
    margin-block-end: 0;
  }

  .send {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-2) var(--space-3);
  }
  .field {
    display: grid;
    gap: var(--space-1);
  }
  .field label {
    font-size: var(--text-sm);
    font-weight: 600;
  }
  #arp-dest {
    width: 10rem;
  }
  .error {
    flex-basis: 100%;
    margin: 0;
    color: var(--color-accent);
    font-weight: 600;
  }
  .error:empty {
    display: none;
  }
  .quick {
    flex-basis: 100%;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .playback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
  }
  .ttl {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .stage {
    position: relative;
    margin: 0;
  }
  .topology {
    display: block;
    width: 100%;
    aspect-ratio: 900 / 500;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    font-family: var(--font-mono);
  }
  @media (width < 40rem) {
    .topology {
      aspect-ratio: 400 / 600;
    }
  }
  .legend {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .swatch {
    display: inline-block;
    width: 1.1em;
    height: 0.8em;
    border-radius: 3px;
    vertical-align: -0.05em;
  }
  .swatch.user {
    border: 2px solid var(--color-text);
    background: var(--color-bg);
  }
  .swatch.infra {
    background: var(--iw-indigo);
  }
  .swatch.you {
    background: var(--color-accent);
    border-radius: 999px;
  }
  .swatch.request {
    background: var(--color-arp-request);
  }
  .swatch.reply {
    background: var(--color-arp-reply);
  }
  .swatch.data {
    background: var(--color-ip-data);
  }

  /* SVG parts are drawn by renderer.js, so their styles are global to this page. */
  .topology :global(.link line),
  .topology :global(.upstream) {
    stroke: var(--iw-copper);
    stroke-width: 4;
  }
  .topology :global(.upstream) {
    stroke-dasharray: 10 6;
  }
  .topology :global(.link.attacker line) {
    stroke-dasharray: 8 6;
  }
  .topology :global(.port) {
    fill: var(--color-text-muted);
    font-size: 13px;
  }
  .topology :global(.node rect),
  .topology :global(.node path) {
    stroke-width: 2;
  }
  .topology :global(.node.user rect:first-child) {
    fill: var(--color-bg);
    stroke: var(--color-text);
  }
  .topology :global(.node.user text) {
    fill: var(--color-text);
  }
  .topology :global(.node.infra rect) {
    fill: var(--iw-indigo);
    stroke: var(--iw-indigo);
  }
  .topology :global(.node.infra text) {
    fill: var(--color-on-brand);
  }
  .topology :global(.node.attacker rect:first-child) {
    stroke: var(--color-accent);
    stroke-dasharray: 6 4;
  }
  /* A failed host: dashed outline and link, muted text (still readable, so no opacity). */
  .topology :global(.link.down line) {
    stroke: var(--color-text-muted);
    stroke-dasharray: 4 6;
  }
  .topology :global(.node.down rect:first-child) {
    stroke: var(--color-text-muted);
    stroke-dasharray: 6 4;
  }
  .topology :global(.node.down text) {
    fill: var(--color-text-muted);
  }
  .topology :global(.node.cloud path) {
    fill: var(--color-bg);
    stroke: var(--color-text-muted);
    stroke-dasharray: 5 4;
  }
  .topology :global(.node.cloud text) {
    fill: var(--color-text-muted);
  }
  .topology :global(.icon rect),
  .topology :global(.icon path) {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1.5;
  }
  .topology :global(.name) {
    font-size: 16px;
    font-weight: 700;
  }
  .topology :global(.role),
  .topology :global(.addr) {
    font-size: 12.5px;
  }
  .topology :global(.you rect) {
    fill: var(--color-accent);
    stroke: none;
  }
  .topology :global(.you text) {
    fill: var(--color-bg);
    font-size: 12px;
    font-weight: 700;
  }
  .topology :global(.frame) {
    cursor: pointer;
  }
  .topology :global(.frame rect) {
    fill: var(--color-bg);
    stroke-width: 2.5;
  }
  .topology :global(.frame text) {
    fill: var(--color-bg);
    font-size: 12px;
    font-weight: 700;
  }
  /* Envelopes: filled in their kind's colour, matching the packet view and legend. */
  .topology :global(.frame.request rect) {
    fill: var(--color-arp-request);
    stroke: var(--color-arp-request);
  }
  .topology :global(.frame.reply rect) {
    fill: var(--color-arp-reply);
    stroke: var(--color-arp-reply);
  }
  .topology :global(.frame.data rect) {
    fill: var(--color-ip-data);
    stroke: var(--color-ip-data);
  }
  .topology :global(.frame:focus-visible) {
    outline: none;
  }
  .topology :global(.frame:focus-visible rect) {
    stroke: var(--color-focus);
    stroke-width: 4;
  }
  .topology :global(.note) {
    fill: var(--color-accent);
    font-size: 13px;
    font-weight: 700;
    animation: fade 2s ease-in forwards;
  }
  @keyframes fade {
    to {
      opacity: 0;
    }
  }

  .bubbles :global(.bubble) {
    position: absolute;
    max-width: min(20rem, 80%);
    display: flex;
    gap: var(--space-2);
    align-items: start;
    padding: var(--space-2) var(--space-3);
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    box-shadow: 0 0.25rem 1rem color-mix(in srgb, var(--color-heading) 20%, transparent);
  }
  .bubbles :global(.bubble p) {
    margin: 0;
  }
  .bubbles :global(.bubble-close) {
    padding: 0 var(--space-2);
    line-height: 1.4;
  }

  /* Packet view: one colour per frame kind, matching the envelope on the diagram. */
  .packet {
    --kind: var(--color-eth);
    border: 2px solid var(--kind);
    border-radius: var(--radius);
    padding: var(--space-3);
    background: var(--color-surface);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }
  .packet[data-kind='request'] {
    --kind: var(--color-arp-request);
  }
  .packet[data-kind='reply'] {
    --kind: var(--color-arp-reply);
  }
  .packet[data-kind='data'] {
    --kind: var(--color-ip-data);
  }
  .packet :global(.packet-head) {
    display: flex;
    justify-content: space-between;
    align-items: start;
    gap: var(--space-3);
  }
  .packet :global(h2) {
    min-width: 0;
    margin: 0;
    font-size: var(--text-lg);
    color: var(--kind);
    overflow-wrap: anywhere;
  }
  .packet :global(h3) {
    margin: 0 0 var(--space-1);
    font-size: var(--text-base);
  }
  .packet :global(.packet-status) {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .packet :global(.packet-body) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
    min-width: 0;
  }

  /* The frame strip: box-drawn blocks sized by byte count, tinted by layer. */
  .packet :global(.strip) {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    border: 1.5px solid var(--color-text);
    border-right: 0;
  }
  .packet :global(.block) {
    --layer: var(--color-eth);
    display: grid;
    align-content: start;
    padding: var(--space-1) var(--space-2);
    border-right: 1.5px solid var(--color-text);
    background: color-mix(in srgb, var(--layer) 16%, var(--color-bg));
    overflow-wrap: anywhere;
  }
  .packet :global(.block.arp) {
    --layer: var(--color-arp-request);
  }
  .packet[data-kind='reply'] :global(.block.arp) {
    --layer: var(--color-arp-reply);
  }
  .packet :global(.block.ip),
  .packet :global(.block.payload) {
    --layer: var(--color-ip-data);
  }
  .packet :global(.block.payload) {
    background: color-mix(in srgb, var(--layer) 8%, var(--color-bg));
  }
  .packet :global(.block.trailer) {
    background: var(--color-bg);
  }
  .packet :global(.block .value) {
    white-space: nowrap;
  }
  .packet :global(.block .label) {
    font-weight: 700;
    color: var(--layer);
  }
  .packet :global(.block.trailer .label) {
    color: var(--color-text-muted);
  }
  .packet :global(.size) {
    color: var(--color-text-muted);
  }

  /* The inner header in 32-bit rows: 32 grid columns, one per bit. */
  .packet :global(.zoom) {
    --layer: var(--kind);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    min-width: 0;
  }
  .packet :global(.zoom h3) {
    font-family: var(--font-body);
    color: var(--layer);
  }
  .packet :global(.ruler),
  .packet :global(.rows) {
    display: grid;
    grid-template-columns: repeat(32, minmax(0, 1fr));
