---
/**
 * ARP simulator (R5, spec section 6). The page holds the empty stage, panels and
 * controls; src/games/arp/controller.js starts the engine and renderer in the browser.
 * Without JavaScript it shows the addressing table and a note.
 */
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagList from '../../components/TagList.astro';
import BackHome from '../../components/BackHome.astro';
import LanSimulator from '../../games/lan/LanSimulator.astro';
import { TOPOLOGY, DEFAULT_TTL_MS, MIN_TTL_MS, MAX_TTL_MS } from '../../games/arp/engine.js';
import { shareCards } from '../../site.config.js';
import { learningResourceLd } from '../../lib/seo.js';
import { getCourse, getTagNames } from '../../lib/content.js';
import { LESSON } from '../../games/arp/lesson.js';
import LessonBreadcrumbs from '../../components/LessonBreadcrumbs.astro';
import LessonPlace from '../../components/LessonPlace.astro';
import LessonNav from '../../components/LessonNav.astro';
import { lessonFor, lessonBreadcrumbs } from '../../lib/path.js';

const entry = await getEntry('learn', 'arp');
if (!entry) throw new Error('src/content/learn/arp.md is missing');

const course = await getCourse();
const lesson = lessonFor(course, 'arp');
if (!lesson) throw new Error('path.yaml has no lesson with entry: arp');
const crumbs = lessonBreadcrumbs(lesson);

const description = entry.data.description ?? entry.data.summary;
const tagNames = await getTagNames();
/** @param {Date} date */
const longDate = (date) => date.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const resource = learningResourceLd({
  path: '/learn/arp',
  title: entry.data.title,
  description,
  published: entry.data.published,
  updated: entry.data.updated,
  keywords: (entry.data.tags ?? []).map((tag) => tagNames[tag] ?? tag),
  image: shareCards.arp.src,
  position: lesson.position,
});

const hosts = TOPOLOGY.nodes.filter((node) => node.role !== 'attacker');
const hostOptions = hosts.map((node) => ({ name: node.name, label: `${node.name} (${node.ip})` }));
const ttlSeconds = DEFAULT_TTL_MS / 1000;
/** The mode switcher's choices; the value is also the URL hash (#learn, #garp). */
const MODES = [
  { value: 'learn', label: 'Learn' },
  { value: 'sandbox', label: 'Sandbox' },
  { value: 'garp', label: 'Gratuitous ARP' },
];
---

<BaseLayout title={entry.data.title} {description} ogImage={shareCards.arp} breadcrumbs={crumbs} jsonLd={[resource]}>
  <LessonBreadcrumbs crumbs={crumbs} />
  <h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>
  <TagList tags={entry.data.tags} />
  {entry.data.published && (
    <p class="dates">
      First published{' '}
      <time datetime={entry.data.published.toISOString().slice(0, 10)}>{longDate(entry.data.published)}</time>
      {entry.data.updated && (
        <>
          {' '}
          · Updated <time datetime={entry.data.updated.toISOString().slice(0, 10)}>{longDate(entry.data.updated)}</time>
        </>
      )}
    </p>
  )}
  <LessonPlace lesson={lesson} />

  <noscript>
    <p class="notice">The simulator needs JavaScript. Here is the network it simulates:</p>
    <table>
      <tr>
        <th scope="col">Node</th>
        <th scope="col">IP</th>
        <th scope="col">MAC</th>
        <th scope="col">Switch port</th>
      </tr>
      {hosts.map((node) => (
        <tr>
          <td>{node.name}</td>
          <td>
            {node.ip}/{node.prefix}
          </td>
          <td>{node.mac}</td>
          <td>{node.port}</td>
        </tr>
      ))}
    </table>
  </noscript>

  <LanSimulator
    prefix="arp"
    modes={MODES}
    sendModes="sandbox garp"
    hosts={hostOptions}
    dest={{ label: 'To IP address', value: '192.0.2.12', inputmode: 'decimal' }}
    quick={[
      { label: 'H2', value: '192.0.2.12' },
      { label: 'an unused address', value: '192.0.2.99' },
      { label: 'the internet (8.8.8.8)', value: '8.8.8.8' },
    ]}
    ttl={{ label: 'Cache TTL', min: MIN_TTL_MS / 1000, max: MAX_TTL_MS / 1000, value: ttlSeconds }}
    legend={[
      { kind: 'request', label: 'ARP request' },
      { kind: 'reply', label: 'ARP reply' },
      { kind: 'data', label: 'IP data (ping, web, DNS)' },
    ]}
    diagramLabel="Network diagram: three user devices and the router R1 on switch SW1"
    cacheTitle="ARP caches"
  >
    <section slot="mode-panels" class="garp" data-modes="garp" aria-labelledby="garp-title" hidden>
      <h2 id="garp-title">Gratuitous ARP</h2>
      <p>
        A gratuitous ARP is a host announcing its own address: an ARP request for its own IP, sent to everyone. Nobody
        replies. Any host that already has that IP in its cache updates the entry to the sender’s MAC, and a host that
        owns the IP itself knows someone else is using it.
      </p>
      <div class="garp-row">
        <label for="garp-host">Announce from</label>
        <select id="garp-host">
          {hosts.map((node) => (
            <option value={node.name}>
              {node.name} ({node.ip})
            </option>
          ))}
        </select>
        <button id="garp-announce" class="primary" type="button">
          Announce
        </button>
      </div>
      <div class="garp-row">
        <button id="garp-failover" type="button">
          Failover: H2 fails, H3 takes over 192.0.2.12
        </button>
        <button id="garp-meanwhile" type="button">
          Meanwhile, on another host…
        </button>
      </div>
      <p class="garp-status" aria-live="polite"></p>
      <details class="garp-uses">
        <summary>Where you meet gratuitous ARP</summary>
        <ul>
          <li>A host announces itself when its interface comes up or DHCP gives it an address.</li>
          <li>
            A high-availability pair of load balancers or firewalls: when the standby takes over the shared address, it
            announces it, so traffic follows straight away instead of waiting for caches to expire. That is the Failover
            button.
          </li>
          <li>
            First-hop redundancy (VRRP, HSRP): the routers share a virtual MAC, so host caches need no change, but the
            new active router announces it so the switches move that MAC to its port.
          </li>
          <li>A virtual machine moving to another server announces itself from its new switch port.</li>
        </ul>
      </details>
      <p class="garp-note">
        <strong>Note:</strong> ARP has no authentication, so hosts believe any announcement. An ARP spoofing
        (man-in-the-middle) attack uses this same path to claim an address it doesn’t own. Switches defend with Dynamic
        ARP Inspection, which checks ARP against the DHCP snooping table; switch it on without trusting a failover
        pair’s port and it blocks the failover too.
      </p>
    </section>
  </LanSimulator>

  <!-- The Learn lesson as plain text, outside the game: readable without JavaScript, and by
       search engines and AI assistants (N11). Same text as Learn mode, from lesson.js. -->
  <section class="lesson-text" aria-labelledby="lesson-text-title">
    <h2 id="lesson-text-title">How ARP works, step by step</h2>
    <details>
      <summary>Read the lesson as text</summary>
      <ol>
        {LESSON.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.caption}</p>
          </li>
        ))}
      </ol>
    </details>
  </section>
  <LessonNav course={course} lesson={lesson} />
  <BackHome />
</BaseLayout>

<script>
  import { startSimulator } from '../../games/arp/controller.js';

  const root = document.querySelector('[data-arp]');
  if (root instanceof HTMLElement) startSimulator(root);
</script>

<style>
  .notice {
    font-weight: 600;
  }
  .lesson-text ol {
    padding-inline-start: 1.5em;
  }
  .lesson-text h3 {
    margin: var(--space-3) 0 var(--space-1);
    font-size: var(--text-base);
  }
  .lesson-text p {
    margin: 0;
  }
  .dates {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* The base control rules again: the GARP panel is slotted into LanSimulator, so it keeps this page's scope and not the component's. */
  button,
  select,
  input {
    font: inherit;
  }
  button {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    padding: var(--space-1) var(--space-3);
    cursor: pointer;
  }
  button:hover:not(:disabled) {
    border-color: var(--color-accent);
  }
  button:disabled {
    cursor: not-allowed;
    color: var(--color-text-muted);
  }
  button.primary {
    background: var(--color-link);
    border-color: var(--color-link);
    color: var(--color-bg);
    font-weight: 600;
  }
  select,
  input:not([type='range']) {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    color: var(--color-text);
    padding: var(--space-1) var(--space-2);
  }

  /* Parts that belong to other modes; beats the display rules below. */
  [data-modes][hidden] {
    display: none;
  }

  .garp {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
  }
  .garp h2 {
    margin: 0 0 var(--space-2);
    font-size: var(--text-lg);
  }
  .garp-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .garp p,
  .garp details {
    margin: 0 0 var(--space-3);
  }
  .garp-row {
    margin-block-end: var(--space-3);
  }
  .garp-row label {
    font-weight: 600;
  }
  .garp-status:empty {
    display: none;
  }
  .garp-status {
    font-weight: 600;
  }
  .garp-uses ul {
    margin: var(--space-2) 0 0;
    padding-inline-start: 1.25em;
  }
  .garp-uses li + li {
    margin-block-start: var(--space-1);
  }
  .garp .garp-note {
    border-inline-start: 4px solid var(--color-accent);
    padding-inline-start: var(--space-3);
    margin-block-end: 0;
  }

  /* The heading rule again, for this page's own h2s (the lesson-text heading); LanSimulator has its own copy. */
  h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
  }
</style>
