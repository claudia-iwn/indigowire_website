---
/** Learn: the course map for "How networking works" (R4, R17, spec section 12), then the documentation address ranges the games use (spec section 3). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { shareCards } from '../../site.config.js';
import BackHome from '../../components/BackHome.astro';
import JourneyPicture from '../../components/JourneyPicture.astro';
import JourneyStrip from '../../components/JourneyStrip.astro';
import { courseLd } from '../../lib/seo.js';
import { getCourse } from '../../lib/content.js';
import { JOURNEY, chaptersForStep } from '../../lib/path.js';

const course = await getCourse();
/** Each journey step links to the first chapter that explains it (like a dict comprehension). */
const stepHrefs = Object.fromEntries(
  JOURNEY.map((step) => {
    const [first] = chaptersForStep(course, step.id);
    return [step.id, first ? `#${first.anchor}` : undefined];
  }),
);
/** @type {Record<string, string>} */
const STATUS = { available: 'Available', next: 'Up next', planned: 'Not available yet' };
/** The part that starts open: the one holding "Up next", else the first available lesson. */
const openPart = (course.next ?? course.start)?.part.number ?? 0;
/**
 * "6 chapters · 1 available" for a part's header.
 * @param {import('../../lib/path.js').Part} part
 */
function partCounts(part) {
  const lessons = part.chapters.flatMap((chapter) => chapter.lessons);
  const available = lessons.filter((lesson) => lesson.status === 'available').length;
  const unit = part.number === 0 ? 'lesson' : 'chapter';
  const count = part.chapters.length;
  const parts = [`${count} ${unit}${count === 1 ? '' : 's'}`, `${available} available`];
  if (lessons.some((lesson) => lesson.status === 'next')) parts.push('Up next inside');
  return parts.join(' · ');
}

/** The documentation ranges used by the games and examples (spec section 3, "Example addresses"). */
const RANGES = [
  {
    family: 'IPv4',
    range: '192.0.2.0/24',
    name: 'TEST-NET-1',
    rfc: 'RFC 5737',
    url: 'https://www.rfc-editor.org/rfc/rfc5737',
    use: 'The ARP game’s LAN: hosts H1 to H3 at .11 to .13, router R1 at .1',
  },
  {
    family: 'IPv4',
    range: '198.51.100.0/24',
    name: 'TEST-NET-2',
    rfc: 'RFC 5737',
    url: 'https://www.rfc-editor.org/rfc/rfc5737',
    use: 'R1’s upstream link (.1) and the next-hop router (.254)',
  },
  {
    family: 'IPv4',
    range: '203.0.113.0/24',
    name: 'TEST-NET-3',
    rfc: 'RFC 5737',
    url: 'https://www.rfc-editor.org/rfc/rfc5737',
    use: 'Held for future games',
  },
  {
    family: 'IPv6',
    range: '2001:db8::/32',
    name: 'Documentation prefix',
    rfc: 'RFC 3849',
    url: 'https://www.rfc-editor.org/rfc/rfc3849',
    use: 'IPv6 examples, such as the packets that decrypt on the Home and About pages',
  },
  {
    family: 'MAC',
    range: '00:00:5e:00:53:00 to 00:00:5e:00:53:ff',
    name: 'Documentation unicast',
    rfc: 'RFC 7042, section 2.1.2',
    url: 'https://www.rfc-editor.org/rfc/rfc7042#section-2.1.2',
    use: 'Every simulated MAC address. The last byte echoes the host’s IP, so H1 (192.0.2.11) is 00:00:5e:00:53:11',
  },
];
---

<BaseLayout
  title="Learn: How networking works"
  description="How networking works, a free course from scratch: follow one photo from your laptop to Leapix and your friends, with interactive games like the IPv4 ARP simulator."
  ogImage={shareCards.learn}
  pageType="CollectionPage"
  breadcrumbs={[{ name: 'Learn', path: '/learn' }]}
  jsonLd={[
    courseLd({
      name: course.title,
      description: 'A free course from scratch: follow one photo from your laptop to Leapix and your friends.',
      lessonPaths: course.lessons.flatMap((l) => (l.page ? [l.page.href] : [])),
    }),
  ]}
>
  <h1>How networking works</h1>

  <section class="start card" aria-labelledby="start-title">
    <h2 id="start-title">Start here</h2>
    <p class="lede">{course.question}</p>
    <p>
      Networks are like plumbing: hidden, and noticed only when the hot water stops. This course follows one photo from
      your laptop to Leapix, a made-up photo site, and on to your friends, and explains each part of the network as the
      photo reaches it. Each lesson builds on the ones before it.
    </p>
    <p>
      Lessons are <strong>Available</strong> (a link), <strong>Up next</strong> (being built now) or{' '}
      <strong>Not available yet</strong>. New games arrive one at a time.
    </p>
    {course.start?.page && (
      <p>
        <a class="start-link" href={course.start.page.href}>
          Start with {course.start.page.title} →
        </a>
      </p>
    )}
  </section>

  <section class="journey-section card" aria-labelledby="journey-title">
    <h2 id="journey-title">The photo’s journey</h2>
    <JourneyPicture />
    <JourneyStrip hrefs={stepHrefs} />
  </section>

  {course.parts.map((part) => (
    <section class="part card" id={part.anchor} aria-labelledby={`${part.anchor}-title`}>
      {/* A native expander: no script needed to open or close it. */}
      <details open={part.number === openPart}>
        <summary>
          <h2 id={`${part.anchor}-title`}>
            Part {part.number}: {part.title}
          </h2>
          <span class="part-counts">{partCounts(part)}</span>
        </summary>
        <ol class="chapters" role="list">
          {part.chapters.map((chapter) => (
            <li class="chapter" id={chapter.anchor}>
              <h3>
                <span class="number">{chapter.number}</span> {chapter.title}
              </h3>
              <p>{chapter.summary}</p>
              {chapter.why && (
                <p class="why">
                  {part.number === 0 ? 'The problem: ' : 'Why you’d care: '}
                  {chapter.why}
                </p>
              )}
              <ul class="lessons" role="list">
                {chapter.lessons.map((lesson) => (
                  <li class={`lesson ${lesson.status}`}>
                    {lesson.familyLabel && <span class="family">{lesson.familyLabel}</span>}
                    {lesson.status === 'available' && lesson.page ? (
                      <a href={lesson.page.href}>{lesson.title}</a>
                    ) : (
                      <span class="title">{lesson.title}</span>
                    )}
                    <span class="kind">{lesson.kind}</span>
                    <span class="status">{STATUS[lesson.status]}</span>
                    {lesson.note && <span class="note">{lesson.note}</span>}
                  </li>
                ))}
              </ul>
              {chapter.deeper.length > 0 && (
                <p class="deeper">
                  Go deeper:{' '}
                  {chapter.deeper.map((target, i) => (
                    <>
                      {i > 0 && ', '}
                      <a href={`#${target.anchor}`}>
                        Chapter {target.number}: {target.title}
                      </a>
                    </>
                  ))}
                </p>
              )}
            </li>
          ))}
        </ol>
      </details>
    </section>
  ))}

  <section class="addresses card" aria-labelledby="addresses-title">
    <h2 id="addresses-title">About the addresses in these games</h2>
    <p>
      Every address in the games and examples on this site comes from a range reserved for documentation. These ranges
      are never assigned to real networks, so nothing you copy from here can clash with a live address.
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Type</th>
            <th scope="col">Range</th>
            <th scope="col">Reserved by</th>
            <th scope="col">Used here for</th>
          </tr>
        </thead>
        <tbody>
          {RANGES.map((r) => (
            <tr>
              <td>{r.family}</td>
              <td>
                <code>{r.range}</code>
                <span class="muted"> ({r.name})</span>
              </td>
              <td>
                <a href={r.url} target="_blank" rel="noopener">
                  {r.rfc}
                </a>
              </td>
              <td>{r.use}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p>
      <strong>One exception:</strong> <code>8.8.8.8</code> stands for “somewhere on the internet”, because almost every
      network engineer recognizes it (it is Google Public DNS). The ARP game uses it only in that role, as the
      destination that has to go through the router.
    </p>
  </section>
  <BackHome />
</BaseLayout>

<script>
  // Open the folded part that holds the linked chapter (or the linked part), then scroll to it:
  // on arrival with a #chapter-… or #part-… link, and when a link on the page changes the hash.
  // Chrome opens <details> for fragment links itself; other browsers need this (spec N2).
  function openLinkedPart() {
    const id = decodeURIComponent(location.hash.slice(1));
    const target = id ? document.getElementById(id) : null;
    // Like Python's `a or b`: the expander around a chapter, or the one inside a part.
    const details = target?.closest('details') ?? target?.querySelector('details');
    if (!target || !details) return;
    if (!details.open) details.open = true;
    target.scrollIntoView();
  }
  openLinkedPart();
  addEventListener('hashchange', openLinkedPart);
</script>

<style>
  .chapters,
  .lessons {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chapter {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-3);
  }
  .chapter h3 {
    margin: 0 0 var(--space-1);
  }
  .chapter p {
    margin: 0 0 var(--space-1);
  }
  .number {
    font-family: var(--font-mono);
    color: var(--color-text-muted);
    margin-inline-end: var(--space-1);
  }
  .why,
  .deeper {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .lesson {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--space-2);
    padding-block: 0.15rem;
  }
  .lesson.planned .title {
    color: var(--color-text-muted);
  }
  .family,
  .kind,
  .status {
    font-size: var(--text-sm);
  }
  .family {
    font-family: var(--font-mono);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0 var(--space-1);
  }
  .kind,
  .status {
    color: var(--color-text-muted);
  }
  /* Up next: a badge in the accent colour, and the word "Up next" (never colour alone). */
  .lesson.next .status {
    color: var(--color-accent);
    font-weight: 600;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 0 var(--space-1);
  }
  .note {
    flex-basis: 100%;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }
  .start-link {
    font-weight: 600;
  }
  /* Each section is a card, so the map reads as distinct pieces (spec section 12). */
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
    margin-block-start: var(--space-4);
  }
  .card > h2 {
    margin-block-start: 0;
  }
  /* A part's header is the expander's button: title, counts, and a turning arrow. */
  /* Arrow in the first column; the title and its counts stacked beside it. */
  .part summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0 var(--space-2);
    cursor: pointer;
    list-style: none;
  }
  .part summary > * {
    grid-column: 2;
  }
  .part summary::-webkit-details-marker {
    display: none;
  }
  .part summary::before {
    content: '▸' / '';
    font-size: var(--text-xl);
    line-height: 1;
    color: var(--color-accent);
  }
  .part details[open] > summary::before {
    content: '▾' / '';
  }
  .part summary h2 {
    margin: 0;
  }
  .part-counts {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .part details[open] > summary {
    margin-block-end: var(--space-2);
  }
  .table-wrap {
    overflow-x: auto;
  }
  table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  th {
    color: var(--color-text-muted);
  }
  code {
    white-space: nowrap;
  }
  .muted {
    color: var(--color-text-muted);
  }
</style>
