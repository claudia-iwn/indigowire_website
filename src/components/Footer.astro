---
/** Site footer: every external link (R1). */
import { site, externalLinks } from '../site.config.js';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <ul>
      {externalLinks.map((link) => (
        <li>
          <a href={link.url} target="_blank" rel="noopener" data-outbound={link.id}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <p>{`© ${year} ${site.name}.`} Code MIT; images and writing all rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  ul {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  p {
    margin: 0;
  }
</style>
