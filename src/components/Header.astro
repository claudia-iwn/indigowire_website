---
/**
 * Site header: logo, internal nav, the header external links (R1) and the
 * light/dark toggle (N5). public/logo.svg and logo-dark.svg come from the PDF
 * master via pdftocairo; CSS shows the one matching the theme, and both are
 * lazy so the hidden one is never downloaded.
 * Below 64rem the nav collapses into a menu sheet opened by the menu button. It uses the
 * HTML popover attribute, so it needs no script: the browser handles opening, Escape,
 * tapping outside and focus. Browsers without popover support show the full nav instead.
 */
import { nav, externalLinks } from '../site.config.js';

const current = Astro.url.pathname;
/** @param {string} href */
const isActive = (href) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Indigo Wire Networks home">
      <img class="theme-light-only" src="/logo.svg" alt="Indigo Wire Networks" width="190" height="50" loading="lazy" />
      <img
        class="theme-dark-only"
        src="/logo-dark.svg"
        alt="Indigo Wire Networks"
        width="190"
        height="50"
        loading="lazy"
      />
    </a>
    <nav id="site-nav" aria-label="Main" popover>
      <div class="menu-head">
        <span class="menu-title">Menu</span>
        <button class="toggle" type="button" popovertarget="site-nav" popovertargetaction="hide">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
          <span class="visually-hidden">Close menu</span>
        </button>
      </div>
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="external">
        {externalLinks
          .filter((link) => link.header)
          .map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener" data-outbound={link.id}>
                {link.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>
    <div class="toggles">
      <!-- Shown once the <head> script marks <html class="js">; without JS there are no effects to turn off. -->
      <button id="effects-toggle" class="toggle" type="button" aria-pressed="true" title="Text effects" data-needs-js>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 7l5 5-5 5M12 18h7"></path>
          <path class="off-slash" d="M4 4l16 16"></path>
        </svg>
        <span class="visually-hidden">Text effects</span>
      </button>
      <!-- Shown once the <head> script marks <html class="js">; without JS the site follows the OS theme. -->
      <button id="theme-toggle" class="toggle" type="button" aria-pressed="false" data-needs-js>
        <svg class="theme-light-only" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
        <svg class="theme-dark-only" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <span class="visually-hidden">Dark theme</span>
      </button>
      <button class="toggle menu-button" type="button" popovertarget="site-nav">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <span class="visually-hidden">Menu</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  // Light/dark toggle (N5). aria-pressed="true" means dark. Choosing the theme the
  // OS already uses forgets the stored choice, so the site follows the OS again.
  (() => {
    const button = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const osDark = matchMedia('(prefers-color-scheme: dark)');
    const osTheme = () => (osDark.matches ? 'dark' : 'light');
    const current = () => root.dataset.theme ?? osTheme();
    const sync = () => button.setAttribute('aria-pressed', String(current() === 'dark'));

    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      try {
        if (next === osTheme()) {
          delete root.dataset.theme; // like Python's `del d["theme"]`
          localStorage.removeItem('theme');
        } else {
          root.dataset.theme = next;
          localStorage.setItem('theme', next);
        }
      } catch {
        root.dataset.theme = next; // storage blocked: apply for this page only
      }
      sync();
    });
    osDark.addEventListener('change', sync);
    sync();
  })();

  // Text effects toggle (the decrypt animations). aria-pressed="true" means on, the
  // default; turning them off is stored and set on <html> as data-effects="off" by the
  // <head> script. Hidden when the OS asks for reduced motion, which already turns them off.
  (() => {
    const button = document.getElementById('effects-toggle');
    const root = document.documentElement;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.effects !== 'off'));

    button.addEventListener('click', () => {
      const off = root.dataset.effects !== 'off';
      if (off) root.dataset.effects = 'off';
      else delete root.dataset.effects;
      try {
        if (off) localStorage.setItem('effects', 'off');
        else localStorage.removeItem('effects');
      } catch {
        // storage blocked: applies to this page only
      }
      sync();
      // Tell running effects (Decrypt.astro) to stop or start. Like emitting a signal.
      document.dispatchEvent(new CustomEvent('effects-change'));
    });
    sync();
  })();
</script>

<style>
  .site-header {
    border-bottom: 3px solid transparent;
    border-image: var(--iw-copper-gradient) 1;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .brand {
    display: inline-flex;
  }
  .brand img {
    display: block;
    /* A little smaller on the narrowest phones, so the logo and buttons share one row. */
    width: min(190px, 44vw);
    height: auto;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  .toggles {
    display: flex;
    gap: var(--space-2);
  }
  /* Buttons that need JavaScript show only once the <head> script has added
     <html class="js">, before first paint, so they never pop in and shift the header. */
  .toggle[data-needs-js] {
    display: none;
  }
  :global(html.js) .toggle[data-needs-js] {
    display: inline-flex;
  }
  /* The OS already turns the effects off, so there is nothing to switch. */
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) #effects-toggle {
      display: none;
    }
  }
  .toggle:hover {
    border-color: var(--color-accent);
  }
  .toggle svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .toggle .off-slash {
    display: none;
  }
  .toggle[aria-pressed='false'] .off-slash {
    display: inline;
  }
  #effects-toggle[aria-pressed='false'] {
    color: var(--color-text-muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  a {
    text-decoration: none;
    font-weight: 600;
  }
  a[aria-current='page'] {
    color: var(--color-accent);
  }
  .external a {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .external a::after {
    content: ' ↗';
  }

  /* Wide screens (and browsers without popover): undo the browser's popover styles so
     the nav is an ordinary row in the header. */
  nav[popover] {
    position: static;
    inset: auto;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    background: none;
    color: inherit;
  }
  .menu-button,
  .menu-head {
    display: none;
  }

  /* Narrow screens: the nav becomes a sheet across the top, opened by the menu button. */
  @media (width < 64rem) {
    @supports selector(:popover-open) {
      .menu-button {
        display: inline-flex;
      }
      nav[popover]:not(:popover-open) {
        display: none;
      }
      nav[popover]:popover-open {
        position: fixed;
        inset: 0 0 auto;
        max-height: 100dvh;
        overflow: auto;
        flex-direction: column;
        gap: var(--space-2);
        padding: var(--space-3);
        background: var(--color-bg);
        border-bottom: 3px solid transparent;
        border-image: var(--iw-copper-gradient) 1;
      }
      nav::backdrop {
        background: color-mix(in srgb, var(--color-heading) 35%, transparent);
      }
      .menu-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .menu-title {
        font-weight: 600;
        color: var(--color-text-muted);
      }
      nav ul {
        flex-direction: column;
        gap: 0;
      }
      nav a {
        display: block;
        padding: var(--space-2) 0;
        font-size: var(--text-lg);
      }
      .external {
        border-top: 1px solid var(--color-border);
        padding-top: var(--space-2);
      }
    }
  }
</style>
