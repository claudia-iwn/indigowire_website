---
/**
 * Site header: logo, internal nav and the header external links (R1).
 * TODO(M1): swap the PNG for public/logo.svg (plus a dark-theme version) once the
 * PDF master is converted (needs `brew install poppler` for pdftocairo).
 */
import { Image } from 'astro:assets';
import logo from '../assets/brand/Indigo Wire Networks_Final.png';
import { nav, externalLinks } from '../site.config.js';

const current = Astro.url.pathname;
/** @param {string} href */
const isActive = (href) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Indigo Wire Networks home">
      <Image src={logo} alt="Indigo Wire Networks" width={190} loading="eager" />
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="external">
        {externalLinks
          .filter((link) => link.header)
          .map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener" data-outbound={link.id}>
                {link.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 3px solid transparent;
    border-image: var(--iw-copper-gradient) 1;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .brand {
    display: inline-flex;
    /* The PNG logo is dark-on-transparent, so give it a light plate in dark mode. */
    background: #ffffff;
    border-radius: var(--radius);
    padding: var(--space-1) var(--space-2);
  }
  .brand :global(img) {
    height: auto;
    display: block;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  a {
    text-decoration: none;
    font-weight: 600;
  }
  a[aria-current='page'] {
    color: var(--color-accent);
  }
  .external a {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .external a::after {
    content: ' ↗';
  }
</style>
