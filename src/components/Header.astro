---
/**
 * Site header: logo, internal nav and the header external links (R1).
 * public/logo.svg and logo-dark.svg come from the PDF master via pdftocairo.
 */
import { nav, externalLinks } from '../site.config.js';

const current = Astro.url.pathname;
/** @param {string} href */
const isActive = (href) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Indigo Wire Networks home">
      <picture>
        <source srcset="/logo-dark.svg" media="(prefers-color-scheme: dark)" />
        <img src="/logo.svg" alt="Indigo Wire Networks" width="190" height="50" />
      </picture>
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="external">
        {externalLinks
          .filter((link) => link.header)
          .map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener" data-outbound={link.id}>
                {link.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 3px solid transparent;
    border-image: var(--iw-copper-gradient) 1;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .brand {
    display: inline-flex;
  }
  .brand img {
    display: block;
    width: 190px;
    height: auto;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  a {
    text-decoration: none;
    font-weight: 600;
  }
  a[aria-current='page'] {
    color: var(--color-accent);
  }
  .external a {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .external a::after {
    content: ' ↗';
  }
</style>
