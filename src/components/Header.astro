---
/**
 * Site header: logo, internal nav, the header external links (R1) and the
 * light/dark toggle (N5). public/logo.svg and logo-dark.svg come from the PDF
 * master via pdftocairo; CSS shows the one matching the theme, and both are
 * lazy so the hidden one is never downloaded.
 */
import { nav, externalLinks } from '../site.config.js';

const current = Astro.url.pathname;
/** @param {string} href */
const isActive = (href) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Indigo Wire Networks home">
      <img class="theme-light-only" src="/logo.svg" alt="Indigo Wire Networks" width="190" height="50" loading="lazy" />
      <img
        class="theme-dark-only"
        src="/logo-dark.svg"
        alt="Indigo Wire Networks"
        width="190"
        height="50"
        loading="lazy"
      />
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ul class="external">
        {externalLinks
          .filter((link) => link.header)
          .map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener" data-outbound={link.id}>
                {link.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>
    <!-- Hidden until the script runs; without JS the site simply follows the OS theme. -->
    <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false" hidden>
      <svg class="theme-light-only" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
      </svg>
      <svg class="theme-dark-only" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
      </svg>
      <span class="visually-hidden">Dark theme</span>
    </button>
  </div>
</header>

<script is:inline>
  // Light/dark toggle (N5). aria-pressed="true" means dark. Choosing the theme the
  // OS already uses forgets the stored choice, so the site follows the OS again.
  (() => {
    const button = document.getElementById('theme-toggle');
    const root = document.documentElement;
    const osDark = matchMedia('(prefers-color-scheme: dark)');
    const osTheme = () => (osDark.matches ? 'dark' : 'light');
    const current = () => root.dataset.theme ?? osTheme();
    const sync = () => button.setAttribute('aria-pressed', String(current() === 'dark'));

    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      try {
        if (next === osTheme()) {
          delete root.dataset.theme; // like Python's `del d["theme"]`
          localStorage.removeItem('theme');
        } else {
          root.dataset.theme = next;
          localStorage.setItem('theme', next);
        }
      } catch {
        root.dataset.theme = next; // storage blocked: apply for this page only
      }
      sync();
    });
    osDark.addEventListener('change', sync);
    button.hidden = false;
    sync();
  })();
</script>

<style>
  .site-header {
    border-bottom: 3px solid transparent;
    border-image: var(--iw-copper-gradient) 1;
  }
  .inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .brand {
    display: inline-flex;
  }
  .brand img {
    display: block;
    width: 190px;
    height: auto;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover {
    border-color: var(--color-accent);
  }
  .theme-toggle svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  a {
    text-decoration: none;
    font-weight: 600;
  }
  a[aria-current='page'] {
    color: var(--color-accent);
  }
  .external a {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .external a::after {
    content: ' ↗';
  }
</style>
